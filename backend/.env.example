PORT=4000
# MongoDB Atlas (or mongodb://localhost:27017/?directConnection=true with the local-db compose profile)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=<app>
MONGODB_DB=career_intelligence
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=<your-google-oauth-web-client-id>.apps.googleusercontent.com
ADMIN_EMAIL=you@example.com
CORS_ORIGIN=http://localhost:5190
LOG_LEVEL=info

# Cloudflare R2 (optional): keeps original uploads. Dashboard > R2 > Manage API tokens (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=careerlens-docs
